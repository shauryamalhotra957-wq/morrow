{
  "name": "morrow-decision-twin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An open, local-first crisis rehearsal lab with transparent assumptions.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/start.ts",
    "build": "npm run build:client && npm run build:api",
    "build:client": "tsc -b && vite build",
    "build:api": "npm run typecheck:api && vite build --config server/vite.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "start:api": "node server/dist/server.js",
    "test": "vitest run",
    "test:api": "vitest run --config server/vitest.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:legal": "node scripts/verify-legal.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "typecheck:api": "tsc --noEmit -p server/tsconfig.json --pretty false",
    "check": "npm run lint && npm run typecheck && npm run typecheck:api && npm run test && npm run test:api && npm run build && npm run verify:legal"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@fontsource/syncopate": "^5.2.8",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "fastify": "^5.10.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
